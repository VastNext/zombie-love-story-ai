# Video Agent environment variables
#
#   cp .env.example .env.development     # local dev, gitignored
#
# Almost nothing belongs here. The chat model, video providers, payments,
# OAuth, email and storage are all entered in the admin panel and stored in
# the database — see the README. Env vars of the same name still work as a
# fallback, but database values win.

# --- Required ---------------------------------------------------------------
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=Video Agent
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:data/local.db
# openssl rand -base64 32
AUTH_SECRET=

# --- Recommended ------------------------------------------------------------
# Encrypts the secrets you save in the admin panel (AES-256-GCM). Leave it
# unset and they are stored as plain text. Once set, keep it: rotating it
# orphans everything already encrypted under the old key.
# openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# --- Optional ---------------------------------------------------------------
VITE_APP_DESCRIPTION=Create and refine AI video clips through conversation.
VITE_APP_LOGO=/logo.png
VITE_DEFAULT_LOCALE=en

# Other databases. DATABASE_PROVIDER: sqlite | postgres | mysql | turso | d1
#   postgres   postgresql://HOST:5432/DBNAME   prefix with USER:PASSWORD@
#   mysql      mysql://HOST:3306/DBNAME        same
#   turso      libsql://DBNAME.turso.io        also set DATABASE_AUTH_TOKEN
# DATABASE_AUTH_TOKEN=

# Extra origins allowed to call the auth API, comma-separated. A leading dot
# is a hostname suffix wildcard, e.g. `.e2b.app` for sandbox previews.
# AUTH_TRUSTED_ORIGINS=

# --- Zombie Love Story ------------------------------------------------------
# Server-only. See API key is NEVER exposed to the browser.
# SEE_API_KEY=
# SEE_API_BASE_URL=https://api.seeapi.com

# Launch mode. `admin_test` = only admins may generate (V1 validation);
# `stripe_sandbox` = only admins may test Stripe Checkout (no generation);
# `live` = public Stripe checkout (V2). The Code is a flow switch, not a secret.
# ZOMBIE_MVP_MODE=admin_test
# Stripe Checkout uses a server-only secret key and the endpoint's signing secret.
# The sandbox mode requires sk_test_... and a test-mode webhook whsec_... .
# STRIPE_SECRET_KEY=
# STRIPE_SIGNING_SECRET=
# 正式切换时保留旧 STRIPE_SIGNING_SECRET 为沙盒签名，正式端点使用独立密钥。
# STRIPE_LIVE_SIGNING_SECRET=
# STRIPE_SANDBOX_SIGNING_SECRET=
# ZOMBIE_ADMIN_TEST_CODE=FountainChan
# ZOMBIE_ADMIN_TEST_USER_LIMIT=3
# ZOMBIE_ADMIN_TEST_GLOBAL_LIMIT=10
# ZOMBIE_GENERATION_PAUSED=false

# 定时任务必须携带 Bearer 密钥；Vercel 自动使用 CRON_SECRET。
# CRON_SECRET=
# ZOMBIE_CRON_SECRET=

# Video model overrides (leave blank to use the built-in default spec).
# ZOMBIE_VIDEO_MODEL=
# ZOMBIE_VIDEO_PROVIDER=
# ZOMBIE_VIDEO_DURATION_SECONDS=

# Landing-page sample video (public). Leave blank to show a placeholder
# instead of a broken player.
# VITE_ZOMBIE_SAMPLE_VIDEO_URL=

# --- Object storage (Cloudflare R2) ------------------------------------------
# Required: SeeAPI fetches the portraits over the public internet, so the photos
# must live in real object storage (base64 is rejected by SeeAPI).
# Secrets are read by the storage service; DB (admin panel) values override env.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET_NAME=
# R2_DOMAIN=            # custom public domain, optional
# R2_ENDPOINT=          # custom endpoint, optional
# R2_UPLOAD_PATH=
